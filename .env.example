# Copy to .env for local development. The packaged application sets these itself
# and reads no .env file, so this is only useful when running from source.

# Shared secret the frontend must send as X-Jawut-Token. The desktop launcher
# generates a fresh one per launch so no other local process can drive the API.
# Leave unset in development to disable the check entirely.
JAWUT_LAUNCH_TOKEN=

# Port for the development uvicorn process. The packaged app ignores this and
# binds port 0 so the OS assigns a free one.
JAWUT_DEV_PORT=8000
